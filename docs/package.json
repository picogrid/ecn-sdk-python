{
  "name": "picogrid-ecn-sdk-docs",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "docs:build": "ASTRO_TELEMETRY_DISABLED=1 astro build && npm run docs:index && node site/write-root-redirect.mjs",
    "docs:dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "docs:index": "pagefind --site ../site-dist/ecn-sdk --output-subdir pagefind --silent",
    "docs:serve": "node site/serve-built-site.mjs",
    "docs:preview": "npm run docs:build && npm run docs:serve",
    "docs:spell": "cspell --no-progress --show-suggestions",
    "docs:check": "ASTRO_TELEMETRY_DISABLED=1 astro check && npm run docs:build && node site/check-built-site.mjs && node site/check-external-links.mjs && npm run docs:spell",
    "docs:check:deploy": "node site/check-deploy-contract.mjs",
    "docs:check:deploy:test": "node --test site/check-deploy-contract.test.mjs",
    "docs:check:public-links": "node site/check-external-links.mjs --require-public",
    "docs:test:browser": "playwright test --config site/playwright.config.ts",
    "docs:test:browser:install": "playwright install chromium",
    "docs:test:delivery": "playwright test --config site/delivery.playwright.config.ts",
    "docs:preview:test": "node --test site/preview-version.test.mjs",
    "docs:legion:test": "node --test site/legion-documentation.test.mjs",
    "docs:version:test": "node --test site/version-control.test.mjs",
    "docs:smoke:test": "node --test site/preview-smoke.test.mjs",
    "docs:smoke:target:test": "node --test site/worker-smoke-target.test.mjs",
    "docs:smoke:local": "node site/require-built-site.mjs && node site/smoke-local-worker.mjs",
    "docs:smoke:preview": "node site/check-preview-smoke.mjs",
    "docs:crawl:readme:test": "node --test site/readme-ecn-crawler.test.mjs",
    "docs:crawl:readme": "node site/check-readme-ecn-links.mjs",
    "docs:compat:test": "node --test site/url-compatibility.test.mjs",
    "docs:compat": "node site/check-url-compatibility.mjs",
    "docs:promote:test": "node --test site/promote-version.test.mjs",
    "docs:probe:readme:test": "node --test site/readme-overcapture-probe.test.mjs",
    "docs:probe:readme": "node site/check-readme-overcapture.mjs",
    "docs:worker:test": "node --test cloudflare/headers.test.ts",
    "docs:worker:dry-run": "node site/require-built-site.mjs && wrangler deploy --dry-run",
    "docs:worker:preview": "npm run docs:build && node site/require-built-site.mjs && wrangler versions upload"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/starlight": "0.41.7",
    "@axe-core/playwright": "4.12.1",
    "@fontsource-variable/chivo-mono": "5.3.0",
    "@playwright/test": "1.62.1",
    "astro": "7.2.0",
    "cspell": "10.0.1",
    "pagefind": "1.5.2",
    "pyright": "1.1.411",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "wrangler": "4.120.0"
  }
}
