---
/**
 * Publish a navigable public source reference beneath the theme footer.
 *
 * Exact build provenance stays in page metadata. This reader-facing line uses
 * the exported release tag or public main so every link resolves in the public
 * distribution repository.
 */
import Footer from '@astrojs/starlight/components/Footer.astro';
import { resolveVersionControl } from '../../site/version-control.mjs';

const repository = 'https://github.com/picogrid/ecn-sdk-python';
const source = resolveVersionControl({ repository });
// Rendered from a single string so the published wording stays byte-stable
// rather than depending on how the template collapses whitespace.
const summary = `Version ${source.version} \u00b7 ${source.sourceKind} `;
---

<Footer />
<p class="documentation-source">{summary}<a href={source.href} title={`Built from ${source.sourceKind} ${source.referenceLabel}`}>{source.referenceLabel}</a></p>

<style>
  .documentation-source {
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .documentation-source a {
    color: inherit;
    font-variant-numeric: tabular-nums;
  }

  .documentation-source a:hover {
    color: var(--sl-color-white);
  }
</style>
