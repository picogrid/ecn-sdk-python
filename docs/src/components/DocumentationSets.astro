---
/**
 * Picogrid's two documentation sets, named as a pair.
 *
 * This guide covers the MQTT v5 client and the Legion API reference covers the
 * REST surface. Both are named in the same order and the same place on both
 * sites, and the set being read is marked, so moving between them is one click
 * from anywhere rather than something to go looking for.
 *
 * The row form sits beside the wordmark on the band; the stacked form is the
 * same pair inside the mobile flyout, where the band has only one row.
 */
import { resolveLegionDocumentation } from '../../site/legion-documentation.mjs';

interface Props {
  /** Render as a full-width list rather than a row on the band. */
  stacked?: boolean;
}

const { stacked = false } = Astro.props;
const { siteTitleHref } = Astro.locals.starlightRoute;
const legion = resolveLegionDocumentation();
const documentation = [
  { label: legion.label, href: legion.href, title: legion.title, current: false },
  { label: 'ECN SDK', href: siteTitleHref, title: undefined, current: true },
];
---

<nav class:list={['documentation-sets', { stacked }]} aria-label="Documentation">
  {documentation.map((entry) => (
    <a
      class="documentation-set"
      href={entry.href}
      title={entry.title}
      aria-current={entry.current ? 'true' : undefined}>{entry.label}</a
    >
  ))}
</nav>

<style>
  /*
   * The gap, metrics, and states are the Legion header's own values, so the
   * pair reads identically on both sites. They are expressed against the colour
   * this band already carries rather than as literal white, so they still hold
   * when the band is not the surface, as in print.
   */
  .documentation-sets {
    display: flex;
    gap: 0.3125rem;
    align-items: center;
  }

  .documentation-set {
    display: inline-flex;
    align-items: center;
    block-size: 2rem; /* 32px — Legion tab */
    padding: 0 0.625rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    color: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .documentation-set:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .documentation-set[aria-current] {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  /* The set being read is already filled, so hover shows on its edge instead. */
  .documentation-set[aria-current]:hover {
    border-color: color-mix(in srgb, currentColor 10%, transparent);
  }

  .documentation-sets.stacked {
    flex-direction: column;
    align-items: stretch;
  }

  .stacked .documentation-set {
    display: block;
    block-size: auto;
    padding: 0.625rem;
    font-size: var(--sl-text-base);
    font-weight: 600;
  }
</style>
