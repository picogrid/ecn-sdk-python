          "type": "integer",
          "required": false,
          "default": 3,
          "description": "Number of valid NTP samples to collect."
        },
        {
          "name": "ECN_CLOCK_TIMEOUT_SECONDS",
          "kind": "env",
          "type": "number",
          "required": false,
