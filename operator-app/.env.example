# Safe local default. The two allowlists are always required.
OPERATOR_MODE=mock
OPERATOR_ECN_CLIENT_INTEGRATION=operator-console
OPERATOR_ECN_INTEGRATION_ALLOWLIST=mock-sensor,mock-target
OPERATOR_ECN_CATEGORY_ALLOWLIST=TRACK,DETECTION,DEVICE
OPERATOR_ECN_WIRE_FORMAT=json
OPERATOR_TASKING_ENABLED=false
# OPERATOR_COMMANDS_FILE=/absolute/path/to/reviewed-commands.json
# Required whenever tasking is enabled, in mock or live mode; canonical
# authorized target UUIDs only.
# OPERATOR_TASK_ENTITY_ALLOWLIST=00000000-0000-4000-8000-000000000000
OPERATOR_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:4173,http://localhost:4173
OPERATOR_ALLOWED_HOSTS=127.0.0.1,localhost

# Bounded local resources.
OPERATOR_MAX_ENTITIES=256
OPERATOR_MAX_BROWSER_CLIENTS=8
OPERATOR_BROWSER_QUEUE_SIZE=16
OPERATOR_DIAGNOSTIC_LIMIT=128
OPERATOR_TASK_HISTORY_LIMIT=64
OPERATOR_PREPARED_TASK_LIMIT=32
OPERATOR_EVENT_BUFFER_SIZE=128
OPERATOR_STALE_AFTER_SECONDS=30
OPERATOR_PREPARE_TTL_SECONDS=30
OPERATOR_SYNTHETIC_PERIOD_SECONDS=0.75

# Optional visual-only basemap. If unset, the app uses the bundled WGS 84
# graticule and performs no tile requests. HTTPS or a root-relative local tile
# path is accepted; query strings and embedded credentials are rejected.
# OPERATOR_BASEMAP_URL_TEMPLATE=https://tiles.example.invalid/{z}/{x}/{y}.png
# OPERATOR_BASEMAP_ATTRIBUTION=Authorized map data provider

# Live mode always requires the endpoint, verified CA, and one authentication
# profile. mTLS is selected when OPERATOR_ECN_AUTH is omitted. Use placeholders
# here, never credentials.
# OPERATOR_MODE=live
# OPERATOR_ECN_HOST=mqtt.example.invalid
# OPERATOR_ECN_MQTT_PORT=<deployment-issued-integer-port-for-selected-auth-profile>
# OPERATOR_ECN_CA_CERT=/run/credentials/ca.crt
#
# mTLS profile (the default when OPERATOR_ECN_AUTH is omitted).
# OPERATOR_ECN_AUTH=mtls
# OPERATOR_ECN_CLIENT_CERT=/run/credentials/client.crt
# OPERATOR_ECN_CLIENT_KEY=/run/credentials/client.key
# OPERATOR_ECN_CLIENT_KEY_PASSWORD=
#
# Bearer profile. The deployment must supply both values; the application does
# not infer the MQTT username or refresh the token proactively.
# OPERATOR_ECN_AUTH=bearer
# OPERATOR_ECN_MQTT_USERNAME=<deployment-issued-mqtt-username>
# OPERATOR_ECN_BEARER_TOKEN=<deployment-issued-token>

# Compose live profile only: host paths and numeric IDs remain outside this repository.
# OPERATOR_CA_CERT_HOST=/absolute/path/outside/repository/ca.crt
# OPERATOR_CLIENT_CERT_HOST=/absolute/path/outside/repository/client.crt
# OPERATOR_CLIENT_KEY_HOST=/absolute/path/outside/repository/client.key
# OPERATOR_CONTAINER_UID=1000
# OPERATOR_CONTAINER_GID=1000
# CLIENT_WHEEL=<exact-inspected-public-client-wheel-filename>
# OPERATOR_WHEEL=<exact-inspected-operator-wheel-filename>
