  "direct_runtime_dependencies": {
    "aiomqtt": {
      "fips_review": "Uses the TLS context supplied by the client; no cryptographic implementation is bundled by this dependency.",
      "native_code": "Pure Python; its paho-mqtt dependency is also pure Python.",
      "rationale": "Provides MQTT v5 client interoperability without embedding a broker or production runtime.",
      "standard_library_alternative": "The standard library has no MQTT client.",
      "target_platforms": "Pure-Python distribution supports Linux x86_64 and aarch64."
    },
    "paho-mqtt": {
      "fips_review": "No cryptographic implementation is bundled; TLS is provided by the Python ssl context supplied through aiomqtt.",
      "native_code": "Pure Python.",
      "rationale": "Provides the MQTT v5 callback API and reason-code objects used directly by the acknowledgement-preserving adapter.",
      "standard_library_alternative": "The standard library has no MQTT client or MQTT v5 acknowledgement API.",
      "target_platforms": "Pure-Python distribution supports Linux x86_64 and aarch64."
    },
    "protobuf": {
      "fips_review": "No cryptographic boundary; review the selected binary wheel under the deployment software policy.",
      "native_code": "Platform wheels may contain the upb implementation; a Python implementation is available with different performance.",
      "rationale": "Decodes and encodes only the committed public interoperability schemas.",
      "standard_library_alternative": "The standard library has no Protocol Buffers implementation.",
      "target_platforms": "Published wheels cover Linux x86_64 and aarch64."
    },
    "pydantic": {
      "fips_review": "No cryptographic boundary; pydantic-core is a native dependency that requires ordinary binary provenance review.",
      "native_code": "Uses the Rust-based pydantic-core binary distribution.",
      "rationale": "Defines the stable validated public API models and JSON schemas required by the contract.",
      "standard_library_alternative": "Dataclasses do not provide equivalent validation or stable JSON Schema generation.",
      "target_platforms": "pydantic-core publishes Linux x86_64 and aarch64 wheels."
    }
  },
